# ==============================================================================
# Environment Configuration — Sharanya Portfolio
# ==============================================================================

# Port configuration (default 3000)
PORT=3000

# Optional: Webhook URL to receive instant notifications for new client inquiries
# Examples: Discord webhook, Slack incoming webhook, Zapier/Make trigger, or custom FastAPI endpoint
# CONTACT_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-token"

# Optional: Supabase Credentials (if storing inquiries or analytics in Supabase)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: Resend API Key for automated confirmation emails
# RESEND_API_KEY="re_123456789"
